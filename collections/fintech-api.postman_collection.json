{
  "info": {
    "_postman_id": "f7053737-d3df-4c27-a86d-c96c06b42a83",
    "name": "Fintech API Testing Portfolio",
    "description": "Automated API tests covering authentication, user data, transactions and negative scenarios against Fake Store API.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Login - Valid credentials",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"Response is JSON\", function () {",
                  "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
                  "});",
                  "",
                  "const response = pm.response.json();",
                  "",
                  "pm.test(\"Authentication token is returned\", function () {",
                  "    pm.expect(response.token).to.be.a(\"string\").and.not.be.empty;",
                  "});",
                  "",
                  "if (response.token) {",
                  "    pm.environment.set(\"authToken\", response.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{validUsername}}\",\n  \"password\": \"{{validPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/auth/login"
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Get user data",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const user = pm.response.json();",
                  "",
                  "pm.test(\"Requested user is returned\", function () {",
                  "    pm.expect(user.id).to.eql(1);",
                  "});",
                  "",
                  "pm.test(\"User contains required fields\", function () {",
                  "    pm.expect(user).to.have.all.keys(\"address\", \"id\", \"email\", \"username\", \"password\", \"name\", \"phone\", \"__v\");",
                  "    pm.expect(user.email).to.be.a(\"string\").and.include(\"@\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/users/1"
          }
        }
      ]
    },
    {
      "name": "Transactions",
      "item": [
        {
          "name": "Get transactions by user",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const transactions = pm.response.json();",
                  "",
                  "pm.test(\"Transactions array is not empty\", function () {",
                  "    pm.expect(transactions).to.be.an(\"array\").that.is.not.empty;",
                  "});",
                  "",
                  "pm.test(\"Every transaction belongs to user 1\", function () {",
                  "    transactions.forEach(function (transaction) {",
                  "        pm.expect(transaction.userId).to.eql(1);",
                  "    });",
                  "});",
                  "",
                  "pm.test(\"Every transaction has required fields\", function () {",
                  "    transactions.forEach(function (transaction) {",
                  "        pm.expect(transaction).to.include.all.keys(\"id\", \"userId\", \"date\", \"products\");",
                  "        pm.expect(transaction.products).to.be.an(\"array\");",
                  "    });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/carts/user/1"
          }
        }
      ]
    },
    {
      "name": "Negative Scenarios",
      "item": [
        {
          "name": "Login - Invalid credentials",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 401\", function () {",
                  "    pm.response.to.have.status(401);",
                  "});",
                  "",
                  "pm.test(\"Error message describes invalid credentials\", function () {",
                  "    pm.expect(pm.response.text().toLowerCase()).to.include(\"incorrect\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{validUsername}}\",\n  \"password\": \"invalid_password\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Login - Missing credentials",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 400\", function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "",
                  "pm.test(\"Error message identifies missing credentials\", function () {",
                  "    pm.expect(pm.response.text().toLowerCase()).to.include(\"not provided\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"\",\n  \"password\": \"\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Get user - Non-existent ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200 as defined by the mock API\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const response = pm.response.json();",
                  "",
                  "pm.test(\"Non-existent user returns null\", function () {",
                  "    pm.expect(response).to.be.null;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/users/9999"
          }
        }
      ]
    }
  ]
}
